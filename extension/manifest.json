{
  "manifest_version": 3,
  "name": "Flipper YT Music Remote",
  "version": "1.0.0",
  "description": "Tells the local bridge whether the current YouTube Music track is liked, and presses like when the Flipper asks.",
  "homepage_url": "https://github.com/Solhex/flipper-now-playing",
  "host_permissions": [
    "https://music.youtube.com/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ytm-bridge@solhex.local",
      "strict_min_version": "115.0"
    }
  }
}
