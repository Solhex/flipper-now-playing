--- a/ytm_bridge.py
+++ b/ytm_bridge.py
@@ -1743,14 +1743,28 @@ async def main_async(args):
     return 0
 
 
-def main():
-    # Line-buffered output: run as a service (or with its log redirected to a
-    # file) a block-buffered stdout would hide the log for minutes.
